rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rule for the users collection
    // Allows authenticated users to read and write their own data only
    match /users/{userId}/books/{bookId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all access by default to other collections/documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
